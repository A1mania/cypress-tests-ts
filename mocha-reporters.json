{
  "reporterEnabled": "mocha-junit-reporter, mochawesome",
  "mochaJunitReporterReporterOptions": {
    "mochaFile": "test-results/junit-[hash].xml",
    "toConsole": true
  },
  "mochawesomeReporterOptions": {
    "reportDir": "cypress-report",
    "overwrite": false,
    "html": false,
    "json": true
  }
}